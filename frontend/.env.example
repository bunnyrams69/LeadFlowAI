# ==============================================================================
# LEADFLOW AI / LEADHUNTER AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your keys as needed.
# Note: You can run the entire app for FREE without any paid keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI ENGINES & PERSONALIZATION (Optional - OpenRouter or Anthropic Claude)
# ------------------------------------------------------------------------------
# Get your key at: https://openrouter.ai/keys OR https://console.anthropic.com
VITE_OPENROUTER_KEY=
VITE_ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. LEAD SCRAPING & DISCOVERY
# ------------------------------------------------------------------------------
# Option A: 100% FREE OpenStreetMap Overpass (No key needed - works out of the box!)
# Option B: Apify Google Maps / Social Scrapers (https://console.apify.com)
VITE_APIFY_TOKEN=
# Option C: SerpAPI Google Maps (https://serpapi.com - 100-250 free searches/mo)
VITE_SERPAPI_KEY=

# ------------------------------------------------------------------------------
# 3. EMAIL FINDER ENRICHMENT (Hunter.io / Apollo)
# ------------------------------------------------------------------------------
# Get 25 free domain searches/mo at: https://hunter.io/api-keys
VITE_HUNTER_API_KEY=
VITE_APOLLO_API_KEY=

# ------------------------------------------------------------------------------
# 4. GMAIL SMTP DISPATCH (16-char App Password)
# ------------------------------------------------------------------------------
# Generate at: https://myaccount.google.com/apppasswords
VITE_SENDER_EMAIL=your-email@gmail.com
VITE_SENDER_NAME=Ganesh
VITE_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# 5. WHATSAPP OUTREACH
# ------------------------------------------------------------------------------
# Option A: 1-Click WhatsApp Web (wa.me link - No key needed, works instantly!)
# Option B: Meta WhatsApp Cloud API (https://developers.facebook.com)
VITE_WHATSAPP_TOKEN=
VITE_WHATSAPP_PHONE_ID=

# ------------------------------------------------------------------------------
# 6. GOOGLE SHEETS CRM AUTO-SYNC
# ------------------------------------------------------------------------------
# Your Google Sheet ID from URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
VITE_GOOGLE_SHEET_ID=

# ------------------------------------------------------------------------------
# 7. DEMO PREVIEW & CLOUDFLARE TUNNEL
# ------------------------------------------------------------------------------
# Base URL for public live demo links (or trycloudflare tunnel URL)
VITE_DEMO_BASE_URL=https://leadflow-demo.tunnel.leadflow.ai/preview
VITE_DRY_RUN=true
